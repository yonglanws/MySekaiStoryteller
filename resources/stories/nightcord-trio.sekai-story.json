    { "type": "LayoutAppear", "wait": true, "delay": 0, "data": { "modelId": 3, "from": { "side": "Center", "offset": 0 }, "to": { "side": "Center", "offset": 0 }, "motion": "w-normal-default01", "facial": "face_normal_01", "facialFirst": true, "moveSpeed": "Normal" } },
    { "type": "Talk", "wait": false, "delay": 0, "data": { "speaker": "奏", "content": "新曲的草稿传上去了……\n大家有空听听看吧。", "ttsText": "新曲のラフをアップしたよ……\n暇があったら聴いてみて。", "modelId": 3, "voice": "", "motion": "w-kanade-nod01", "facial": "face_normal_01" } },
    { "type": "LayoutAppear", "wait": true, "delay": 0, "data": { "modelId": 1, "from": { "side": "Left", "offset": 100 }, "to": { "side": "Left", "offset": 0 }, "motion": "w-happy-glad01", "facial": "face_smile_01", "facialFirst": true, "moveSpeed": "Normal" } },
    { "type": "Talk", "wait": false, "delay": 0.1, "data": { "speaker": "瑞希", "content": "来了来了！刚看到通知～\n我可是第一时间冲进来的哦。", "ttsText": "来た来た！通知を見て即駆けつけたよ〜。", "modelId": 1, "voice": "", "motion": "w-happy-glad01", "facial": "face_smile_01" } },
    { "type": "Talk", "wait": false, "delay": 0, "data": { "speaker": "奏", "content": "嗯……不过前奏，\n可能还是太安静了一点。", "ttsText": "うん……でも前奏は、まだ静かすぎるかな。", "modelId": 3, "voice": "", "motion": "w-kanade-lookdown01", "facial": "face_sad_01" } },
    { "type": "Motion", "wait": false, "delay": 0.1, "data": { "modelId": 1, "motion": "w-normal-nod01", "facial": "face_smile_01", "facialFirst": false } },
    { "type": "Talk", "wait": false, "delay": 0, "data": { "speaker": "瑞希", "content": "不会呀，我觉得这种安静刚刚好。\n深夜的Nightcord就该是这个感觉！", "ttsText": "全然平気だよ。この静けさがちょうどいい。\n深夜のNightcordってこういう感じでしょ！", "modelId": 1, "voice": "", "motion": "w-happy-nod01", "facial": "face_smile_01" } },
    { "type": "LayoutAppear", "wait": true, "delay": 0, "data": { "modelId": 2, "from": { "side": "Right", "offset": 100 }, "to": { "side": "Right", "offset": 0 }, "motion": "w-normal-default01", "facial": "face_normal_01", "facialFirst": true, "moveSpeed": "Normal" } },
    { "type": "Talk", "wait": false, "delay": 0.1, "data": { "speaker": "绘名", "content": "让我顺便看看封面……喂，\n这构图是不是也太素了点？", "ttsText": "ついでに表紙も見たけど……おい、\nこの構図、さっぱりしすぎじゃない？", "modelId": 2, "voice": "", "motion": "w-cool-tilthead01", "facial": "face_normal_01" } },
    { "type": "Motion", "wait": false, "delay": 0.1, "data": { "modelId": 3, "motion": "w-kanade-nod01", "facial": "face_normal_01", "facialFirst": false } },
    { "type": "Talk", "wait": false, "delay": 0, "data": { "speaker": "瑞希", "content": "素才有留白感嘛！封面交给我，\n保证又好看又显眼～", "ttsText": "白い方が余白があっていいでしょ！表紙は私に任せて、\n可愛くて目立つのにするから〜", "modelId": 1, "voice": "", "motion": "w-cute-tilthead01", "facial": "face_wink_01" } },
    { "type": "Talk", "wait": false, "delay": 0, "data": { "speaker": "绘名", "content": "你上次也这么说的，\n结果贴了一整排蝴蝶结。", "ttsText": "前もそう言ってたけど、\n結果リボンだらけになったよね。", "modelId": 2, "voice": "", "motion": "w-cute-angry01", "facial": "face_angry_01" } },
    { "type": "Motion", "wait": false, "delay": 0.1, "data": { "modelId": 1, "motion": "w-normal-lookaway01", "facial": "face_smile_01", "facialFirst": false } },
    { "type": "Talk", "wait": false, "delay": 0, "data": { "speaker": "奏", "content": "不过……有瑞希做的封面，\n大家应该会更愿意点进来听。", "ttsText": "でも……瑞希の表紙なら、\nみんな聴いてくれる気がする。", "modelId": 3, "voice": "", "motion": "w-kanade-glad01", "facial": "face_smile_01" } },
    { "type": "Talk", "wait": false, "delay": 0, "data": { "speaker": "绘名", "content": "连奏都这么说了，行吧，封面交给瑞希。\n但色调要跟着曲子走，不许乱来。", "ttsText": "奏までそう言うなら、仕方ない、表紙は瑞希に任せる。\nでも色は曲に合わせてね、勝手にしないで。", "modelId": 2, "voice": "", "motion": "w-normal-nod01", "facial": "face_smile_02" } },
    { "type": "Talk", "wait": false, "delay": 0.1, "data": { "speaker": "瑞希", "content": "包在我身上！话说，\n这首曲子叫什么名字呀？", "ttsText": "任せて！ところで、この曲のタイトルは何？", "modelId": 1, "voice": "", "motion": "w-happy-wandahoi01", "facial": "face_surprise_01" } },
    { "type": "Talk", "wait": false, "delay": 0, "data": { "speaker": "奏", "content": "还没定……想先听完你们的感受，\n再决定叫什么。", "ttsText": "まだ決めてない……二人の感想を聴いてから、\n決めようと思って。", "modelId": 3, "voice": "", "motion": "w-kanade-lookdown01", "facial": "face_normal_01" } },
    { "type": "Talk", "wait": false, "delay": 0, "data": { "speaker": "绘名", "content": "那就叫《留白》怎么样？\n反正前奏那么安静。", "ttsText": "じゃあ『余白』はどう？\nどうせ前奏あんなに静かだし。", "modelId": 2, "voice": "", "motion": "w-cute-glad01", "facial": "face_smile_02" } },
    { "type": "Motion", "wait": false, "delay": 0.1, "data": { "modelId": 1, "motion": "w-happy-nod01", "facial": "face_smile_01", "facialFirst": false } },
    { "type": "Talk", "wait": false, "delay": 0, "data": { "speaker": "奏", "content": "《留白》……嗯，就它了。\n谢谢你们。", "ttsText": "『余白』……うん、それにする。\nありがとう。", "modelId": 3, "voice": "", "motion": "w-normal-nod01", "facial": "face_smile_01" } },
    { "type": "Talk", "wait": false, "delay": 0.1, "data": { "speaker": "瑞希", "content": "那今晚我就把封面画出来～\n明天让你们大吃一惊！", "ttsText": "今夜中に表紙描いちゃう〜\n明日、びっくりさせてあげる！", "modelId": 1, "voice": "", "motion": "w-happy-glad01", "facial": "face_smile_01" } },
