  "snippets": [
    { "type": "ChangeLayoutMode", "wait": false, "delay": 0, "data": { "mode": "Three" } },
    { "type": "BlackOut", "wait": true, "delay": 0, "data": { "duration": 500 } },
    { "type": "ChangeBackgroundImage", "wait": true, "delay": 0, "data": { "imageId": 1 } },
    { "type": "BlackIn", "wait": true, "delay": 0, "data": { "duration": 800 } },
    { "type": "Telop", "wait": true, "delay": 0.2, "data": { "content": "深夜23时 · 奏的房间" } },
    { "type": "LayoutAppear", "wait": true, "delay": 0, "data": { "modelId": 1, "from": { "side": "Left", "offset": -100 }, "to": { "side": "Left", "offset": 0 }, "motion": "w-happy-glad01", "facial": "face_smile_01", "facialFirst": true, "moveSpeed": "Normal" } },
    { "type": "Talk", "wait": false, "delay": 0, "data": { "speaker": "瑞希", "content": "万圣节限定·南瓜甜点塔，完成！\n装饰了整整三次的成果，可爱吧！", "ttsText": "ハロウィン限定・かぼちゃスイーツタワー、完成！\n三回もデコした成果物、可愛いでしょ？", "modelId": 1, "voice": "", "motion": "w-happy-glad01", "facial": "face_smile_01" } },
    { "type": "LayoutAppear", "wait": true, "delay": 0.1, "data": { "modelId": 2, "from": { "side": "Right", "offset": 100 }, "to": { "side": "Right", "offset": 0 }, "motion": "w-cool-tilthead01", "facial": "face_angry_01", "facialFirst": true, "moveSpeed": "Normal" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "绘名", "content": "……为什么是南瓜。\n还有，这座塔，歪了吧。左边明显塌了一块。", "ttsText": "……なんでかぼちゃなの。\nそれにこのタワー、傾いてない？左、明らかに崩れてるんだけど。", "modelId": 2, "voice": "", "motion": "w-cool-tilthead01", "facial": "face_angry_01" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "瑞希", "content": "那叫设计感！\n……比起这个，绘名负责的蛋糕呢？", "ttsText": "デザイン感って言ってるの！\n……ていうか、絵名が担当のケーキは？", "modelId": 1, "voice": "", "motion": "w-cute-tilthead01", "facial": "face_wink_01" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "绘名", "content": "……烤糊了两轮。第三轮，\n我把它切成方块，对外宣称是\"创意戚风\"。", "ttsText": "……二回焦がした。三回目は、\n四角く切り出して「クリエイティブなシフォン」ってことにした。", "modelId": 2, "voice": "", "motion": "w-normal-lookaway01", "facial": "face_normal_01" } },
    { "type": "LayoutAppear", "wait": true, "delay": 0.1, "data": { "modelId": 3, "from": { "side": "Center", "offset": -100 }, "to": { "side": "Center", "offset": 0 }, "motion": "w-kanade-lookdown01", "facial": "face_normal_01", "facialFirst": true, "moveSpeed": "Normal" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "奏", "content": "没关系……冰淇淋，我也准备了两升。\n方形的……也很适合配曲子。", "ttsText": "大丈夫……アイスも二リットル用意したから。\n四角いの……曲にも合うし。", "modelId": 3, "voice": "", "motion": "w-kanade-nod01", "facial": "face_smile_01" } },
    { "type": "Talk", "wait": false, "delay": 0.2, "data": { "speaker": "瑞希", "content": "话说回来——雪真的会来吗？\n这可是四个人第一次线下聚会诶！", "ttsText": "ところで——雪、本当に来るかな？\n四人で初のオフ会だよ？", "modelId": 1, "voice": "", "motion": "w-happy-nod01", "facial": "face_smile_01" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "奏", "content": "嗯……昨天她在 Nightcord 上说，\n\"想试试看\"。……那孩子，正在一点点往前走。", "ttsText": "うん……昨日Nightcordで言ってた。\n「試してみてもいい」って。……あの子は、少しずつ前に進んでる。", "modelId": 3, "voice": "", "motion": "w-kanade-nod01", "facial": "face_smile_01" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "绘名", "content": "中途要是又突然关机跑路，\n我就……我就把她的份全吃掉！", "ttsText": "途中でまた電源切って逃げたら、\n……そ、その分ぜんぶ食べてやるから！", "modelId": 2, "voice": "", "motion": "w-cute-angry01", "facial": "face_angry_01" } },
    { "type": "Talk", "wait": false, "delay": 0.2, "data": { "speaker": "奏", "content": "绘名。……门铃。", "ttsText": "絵名。……チャイム。", "modelId": 3, "voice": "", "motion": "w-kanade-tilthead01", "facial": "face_surprise_01" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "绘名", "content": "！……我、我去楼下接她！\n才、才不是紧张，是怕她走丢！", "ttsText": "！……わ、私が下まで迎えに行く！\nど、どきどきしてるんじゃない、迷子になるから！", "modelId": 2, "voice": "", "motion": "w-cute-angry01", "facial": "face_surprise_01" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "瑞希", "content": "那我搬甜点！奏负责开门倒茶～\n小心哦绘名，楼梯别摔了！", "ttsText": "じゃあ私はスイーツ運び！奏はドアとお茶担当～\n絵名、階段で転ばないでね！", "modelId": 1, "voice": "", "motion": "w-happy-nod01", "facial": "face_smile_01" } },
    { "type": "HideTalk", "wait": true, "delay": 0.2 },
    { "type": "LayoutClear", "wait": true, "delay": 0.1, "data": { "modelId": 1, "from": { "side": "Left", "offset": 0 }, "to": { "side": "Left", "offset": -100 }, "motion": "w-happy-nod01", "facial": "face_smile_01", "moveSpeed": "Normal" } },
    { "type": "LayoutClear", "wait": true, "delay": 0.1, "data": { "modelId": 2, "from": { "side": "Right", "offset": 0 }, "to": { "side": "Right", "offset": 100 }, "motion": "w-cute-angry01", "facial": "face_surprise_01", "moveSpeed": "Normal" } },
    { "type": "LayoutClear", "wait": true, "delay": 0.1, "data": { "modelId": 3, "from": { "side": "Center", "offset": 0 }, "to": { "side": "Center", "offset": 100 }, "motion": "w-kanade-nod01", "facial": "face_smile_01", "moveSpeed": "Normal" } },
    { "type": "BlackOut", "wait": true, "delay": 0, "data": { "duration": 700 } },
    { "type": "ChangeBackgroundImage", "wait": true, "delay": 0, "data": { "imageId": 2 } },
    { "type": "BlackIn", "wait": true, "delay": 0, "data": { "duration": 900 } },
    { "type": "Telop", "wait": true, "delay": 0.2, "data": { "content": "然后，门开了" } },
    { "type": "LayoutAppear", "wait": true, "delay": 0, "data": { "modelId": 4, "from": { "side": "Center", "offset": -100 }, "to": { "side": "Center", "offset": 0 }, "motion": "w-normal-sigh01", "facial": "face_normal_01", "facialFirst": true, "moveSpeed": "Normal" } },
    { "type": "Talk", "wait": false, "delay": 0, "data": { "speaker": "真冬", "content": "……打扰了。这里，就是 K 的房间啊。\n比想象中……要温馨。", "ttsText": "……お邪魔します。ここが、Kの部屋なんだ。\n想像より……あたたかいところ。", "modelId": 4, "voice": "", "motion": "w-normal-sigh01", "facial": "face_normal_01" } },
    { "type": "LayoutAppear", "wait": true, "delay": 0.1, "data": { "modelId": 3, "from": { "side": "Left", "offset": -100 }, "to": { "side": "Left", "offset": 0 }, "motion": "w-kanade-glad01", "facial": "face_smile_01", "facialFirst": true, "moveSpeed": "Normal" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "奏", "content": "欢迎回来，雪。\n……啊，说错了。是\"欢迎光临\"。请进。", "ttsText": "おかえり、雪。\n……あ、違った。「いらっしゃい」。どうぞ。", "modelId": 3, "voice": "", "motion": "w-kanade-nod01", "facial": "face_smile_01" } },
    { "type": "Talk", "wait": false, "delay": 0.2, "data": { "speaker": "真冬", "content": "……\"欢迎回来\"。\n……嗯。那我就——我回来了。", "ttsText": "……「おかえり」。\n……うん。それじゃ——ただいま。", "modelId": 4, "voice": "", "motion": "w-normal-lookaway01", "facial": "face_smile_01" } },
    { "type": "LayoutAppear", "wait": true, "delay": 0.1, "data": { "modelId": 1, "from": { "side": "Right", "offset": 100 }, "to": { "side": "Right", "offset": 0 }, "motion": "w-happy-glad01", "facial": "face_smile_01", "facialFirst": true, "moveSpeed": "Normal" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "瑞希", "content": "雪～这边这边！\n按生日惯例——南瓜塔的第一口，请你吃！", "ttsText": "雪～こっちこっち！\n記念すべき一口目——かぼちゃタワー、あーんさせて！", "modelId": 1, "voice": "", "motion": "w-happy-glad01", "facial": "face_smile_01" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "真冬", "content": "南瓜塔……做得好精致。\n蝴蝶结的部分，也好可爱。", "ttsText": "かぼちゃタワー……よくできてる。\nリボンのところとか、可愛い。", "modelId": 4, "voice": "", "motion": "w-cool-tilthead01", "facial": "face_smile_01" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "瑞希", "content": "听到夸奖了！快快，别客气——", "ttsText": "褒められた！ささ、遠慮なく——", "modelId": 1, "voice": "", "motion": "w-happy-nod01", "facial": "face_smile_01" } },
    { "type": "Talk", "wait": false, "delay": 0.25, "data": { "speaker": "真冬", "content": "…………。\n……是甜的。今天——尝得出甜味。", "ttsText": "…………。\n……甘い。今日は——甘さが、分かる。", "modelId": 4, "voice": "", "motion": "w-normal-lookaway01", "facial": "face_surprise_01" } },
    { "type": "Motion", "wait": false, "delay": 0.1, "data": { "modelId": 3, "motion": "w-kanade-glad01", "facial": "face_smile_01", "facialFirst": false } },
    { "type": "Talk", "wait": false, "delay": 0.2, "data": { "speaker": "瑞希", "content": "诶诶诶——！那就是说，\n好起来了对吧？！绘名要是听到绝对要哭！", "ttsText": "えええ——！ってことは、\n良くなってるってことだよね？！絵名が聞いたら絶対泣く！", "modelId": 1, "voice": "", "motion": "w-happy-glad01", "facial": "face_surprise_01" } },
    { "type": "Talk", "wait": false, "delay": 0.2, "data": { "speaker": "奏", "content": "雪……太好了。\n今天这首曲子，我想写成『甜味』主题的。", "ttsText": "雪……よかった。\n今日の曲は、「甘さ」をテーマに書きたいな。", "modelId": 3, "voice": "", "motion": "w-kanade-nod01", "facial": "face_smile_01" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "真冬", "content": "嗯。和大家在一起的时候，\n味道会慢慢地……回来一点。\n……谢谢。很好吃。", "ttsText": "うん。みんなと一緒にいると、\n味が少しずつ……戻ってくる。\n……ありがとう。美味しかった。", "modelId": 4, "voice": "", "motion": "w-normal-nod01", "facial": "face_smile_01" } },
    { "type": "Talk", "wait": false, "delay": 0.2, "data": { "speaker": "瑞希", "content": "啊——绘名那家伙错过了历史性瞬间！\n她买饮料怎么还没回来？", "ttsText": "あ——絵名が歴史的瞬間に居なかった！\n飲み物買って、まだ戻ってこないの？", "modelId": 1, "voice": "", "motion": "w-cute-tilthead01", "facial": "face_wink_01" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "真冬", "content": "在楼下碰到了。她说\"我先上去占位子\"……\n然后，走得非常快。像是逃走一样。", "ttsText": "下で会ったよ。「先に席取る」って……\nそれで、すごい足早で。逃げるみたいに。", "modelId": 4, "voice": "", "motion": "w-cool-tilthead01", "facial": "face_normal_01" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "瑞希", "content": "噗——那绝对是跑去哭了吧，\n我们那个傲娇插画师！", "ttsText": "ぷっ——それ絶対泣きに行ったでしょ、\nうちのツンデレイラストレーター！", "modelId": 1, "voice": "", "motion": "w-happy-nod01", "facial": "face_smile_01" } },
    { "type": "HideTalk", "wait": true, "delay": 0.2 },
    { "type": "LayoutClear", "wait": true, "delay": 0.1, "data": { "modelId": 1, "from": { "side": "Right", "offset": 0 }, "to": { "side": "Right", "offset": 100 }, "motion": "w-happy-glad01", "facial": "face_smile_01", "moveSpeed": "Normal" } },
    { "type": "LayoutClear", "wait": true, "delay": 0.1, "data": { "modelId": 3, "from": { "side": "Left", "offset": 0 }, "to": { "side": "Left", "offset": -100 }, "motion": "w-kanade-nod01", "facial": "face_smile_01", "moveSpeed": "Normal" } },
    { "type": "LayoutClear", "wait": true, "delay": 0.1, "data": { "modelId": 4, "from": { "side": "Center", "offset": 0 }, "to": { "side": "Center", "offset": 100 }, "motion": "w-normal-nod01", "facial": "face_smile_01", "moveSpeed": "Normal" } },
    { "type": "BlackOut", "wait": true, "delay": 0, "data": { "duration": 700 } },
    { "type": "BlackIn", "wait": true, "delay": 0, "data": { "duration": 700 } },
    { "type": "Telop", "wait": true, "delay": 0.2, "data": { "content": "三十分钟后" } },
    { "type": "LayoutAppear", "wait": true, "delay": 0, "data": { "modelId": 3, "from": { "side": "Center", "offset": -100 }, "to": { "side": "Center", "offset": 0 }, "motion": "w-kanade-tilthead01", "facial": "face_smile_01", "facialFirst": true, "moveSpeed": "Normal" } },
    { "type": "Talk", "wait": false, "delay": 0, "data": { "speaker": "奏", "content": "绘名，走廊都听得到你的声音哦。", "ttsText": "絵名、声が廊下まで聞こえてるよ。", "modelId": 3, "voice": "", "motion": "w-kanade-tilthead01", "facial": "face_smile_01" } },
    { "type": "LayoutAppear", "wait": true, "delay": 0.1, "data": { "modelId": 2, "from": { "side": "Right", "offset": 100 }, "to": { "side": "Right", "offset": 0 }, "motion": "w-cute-angry01", "facial": "face_angry_01", "facialFirst": true, "moveSpeed": "Normal" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "绘名", "content": "你们——居然！先！吃了！！\n说好的\"等人齐再开动\"呢！", "ttsText": "あんたたち——まさか！先に！食べたの？！\n「全員揃ってから」って約束は？！"} },
    { "type": "LayoutAppear", "wait": true, "delay": 0.1, "data": { "modelId": 4, "from": { "side": "Left", "offset": -100 }, "to": { "side": "Left", "offset": 0 }, "motion": "w-normal-lookaway01", "facial": "face_normal_01", "facialFirst": true, "moveSpeed": "Normal" } },
    { "type": "Talk", "wait": false, "delay": 0.2, "data": { "speaker": "真冬", "content": "对不起。……但是，很好吃。\n绘名的蛋糕，真的。", "ttsText": "ごめんなさい。……でも、美味しかった。\n絵名のケーキ、本当に。", "modelId": 4, "voice": "", "motion": "w-normal-nod01", "facial": "face_smile_01" } },
    { "type": "Talk", "wait": false, "delay": 0.2, "data": { "speaker": "绘名", "content": "唔……被当事人这么一说，\n我还能怎么样嘛……", "ttsText": "うっ……本人にそう言われたら、\n私だってどうにもできないじゃない……", "modelId": 2, "voice": "", "motion": "w-normal-lookaway01", "facial": "face_normal_01" } },
    { "type": "Talk", "wait": false, "delay": 0.2, "data": { "speaker": "真冬", "content": "所以……下次，我还想吃。可以吗？", "ttsText": "だから……今度、また食べたい。いい？", "modelId": 4, "voice": "", "motion": "w-normal-lookaway01", "facial": "face_smile_01" } },
    { "type": "Talk", "wait": false, "delay": 0.2, "data": { "speaker": "绘名", "content": "……哈，真拿你们没办法！\n下次给你们烤个不糊的——二十五种口味的！", "ttsText": "……はぁ、しょうがないない！\n今度は焦がさないのを焼いてあげる——二十五種類ね！", "modelId": 2, "voice": "", "motion": "w-cute-glad01", "facial": "face_smile_01" } },
    { "type": "Motion", "wait": false, "delay": 0.1, "data": { "modelId": 4, "motion": "w-cool-tilthead01", "facial": "face_surprise_01", "facialFirst": false } },
    { "type": "Talk", "wait": false, "delay": 0.2, "data": { "speaker": "真冬", "content": "二十五种……嗯，期待。\n下次——除了听曲子，我也想试试别的事。", "ttsText": "二十五種類……うん、楽しみ。\n今度は——曲を聴く以外のことも、やってみたい。", "modelId": 4, "voice": "", "motion": "w-normal-nod01", "facial": "face_smile_01" } },
    { "type": "Talk", "wait": false, "delay": 0.2, "data": { "speaker": "奏", "content": "嗯。那就说定了——\n下次，大家，一起来。", "ttsText": "うん。約束——\n今度は、みんなで、一緒に。", "modelId": 3, "voice": "", "motion": "w-kanade-nod01", "facial": "face_smile_01" } },
    { "type": "HideTalk", "wait": true, "delay": 0.2 },
    { "type": "LayoutClear", "wait": true, "delay": 0.1, "data": { "modelId": 2, "from": { "side": "Right", "offset": 0 }, "to": { "side": "Right", "offset": 100 }, "motion": "w-cute-glad01", "facial": "face_smile_01", "moveSpeed": "Normal" } },
    { "type": "LayoutClear", "wait": true, "delay": 0.1, "data": { "modelId": 4, "from": { "side": "Left", "offset": 0 }, "to": { "side": "Left", "offset": -100 }, "motion": "w-normal-nod01", "facial": "face_smile_01", "moveSpeed": "Normal" } },
    { "type": "LayoutClear", "wait": true, "delay": 0.1, "data": { "modelId": 3, "from": { "side": "Center", "offset": 0 }, "to": { "side": "Center", "offset": 100 }, "motion": "w-kanade-glad01", "facial": "face_smile_01", "moveSpeed": "Normal" } },
    { "type": "BlackOut", "wait": true, "delay": 0, "data": { "duration": 800 } }
  ]
}
