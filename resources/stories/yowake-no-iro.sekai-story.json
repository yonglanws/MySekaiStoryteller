  ],
  "snippets": [
    { "type": "ChangeLayoutMode", "wait": false, "delay": 0, "data": { "mode": "Three" } },
    { "type": "BlackOut", "wait": true, "delay": 0, "data": { "duration": 600 } },
    { "type": "ChangeBackgroundImage", "wait": true, "delay": 0, "data": { "imageId": 1 } },
    { "type": "BlackIn", "wait": true, "delay": 0, "data": { "duration": 900 } },
    { "type": "Telop", "wait": true, "delay": 0.2, "data": { "content": "25:00 —— 夜明け前" } },

    { "type": "LayoutAppear", "wait": true, "delay": 0, "data": { "modelId": 3, "from": { "side": "Center", "offset": -100 }, "to": { "side": "Center", "offset": 0 }, "motion": "w-normal-sigh01", "facial": "face_tired_01", "facialFirst": true, "moveSpeed": "Normal" } },
    { "type": "Talk", "wait": false, "delay": 0.2, "data": { "speaker": "奏", "content": "又到了这个时间……\n新建的工程里，还是只有一段旋律。", "ttsText": "またこの時間になった……\n新規のプロジェクトには、まだメロディの一段落しかない。", "modelId": 3, "voice": "", "motion": "w-normal-sigh01", "facial": "face_tired_01" } },
    { "type": "Motion", "wait": false, "delay": 0.1, "data": { "modelId": 3, "motion": "w-kanade-lookdown01", "facial": "face_sad_01", "facialFirst": false } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "奏", "content": "曲名叫《夜明けの色》。\n可是写到一半才发现……我根本，没见过黎明。", "ttsText": "曲名は『夜明けの色』。\nでも書いてる途中で気づいた……私、夜明けなんて見たことなかった。", "modelId": 3, "voice": "", "motion": "w-kanade-lookdown01", "facial": "face_sad_01" } },

    { "type": "LayoutAppear", "wait": true, "delay": 0.2, "data": { "modelId": 1, "from": { "side": "Left", "offset": -100 }, "to": { "side": "Left", "offset": 0 }, "motion": "w-happy-glad01", "facial": "face_smile_01", "facialFirst": true, "moveSpeed": "Normal" } },
    { "type": "Talk", "wait": false, "delay": 0.2, "data": { "speaker": "瑞希", "content": "让一让让一让～深夜的救世主登场！\n奏，今天也卡住了吧？", "ttsText": "どいてどいて〜深夜の救世主の登場だよ！\n奏、今日も詰まってるでしょ？", "modelId": 1, "voice": "", "motion": "w-happy-glad01", "facial": "face_smile_01" } },
    { "type": "LayoutAppear", "wait": true, "delay": 0.2, "data": { "modelId": 2, "from": { "side": "Right", "offset": 100 }, "to": { "side": "Right", "offset": 0 }, "motion": "w-cool-tilthead01", "facial": "face_normal_01", "facialFirst": true, "moveSpeed": "Normal" } },
    { "type": "Talk", "wait": false, "delay": 0.2, "data": { "speaker": "绘名", "content": "大半夜把文件丢过来还一句话不说，\n吓死人你知道吗。", "ttsText": "真夜中にいきなりファイル投げてきて、何も言わないとか。\nびっくりするでしょ。", "modelId": 2, "voice": "", "motion": "w-cool-tilthead01", "facial": "face_trouble_01" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "奏", "content": "对不起……想写完了再给你们听。\n可这一段，怎么写都不对。", "ttsText": "ごめん……完成してから聴かせたかったの。\nでもこの部分、どう書いても違うままなの。", "modelId": 3, "voice": "", "motion": "w-kanade-nod01", "facial": "face_sad_02" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "瑞希", "content": "我听听看！……嗯、嗯？？\n这不是超好听的吗！哪里不对了呀！", "ttsText": "聴く聴く！……ん、ん？？\nめっちゃいい曲じゃん！どこがおかしいの！", "modelId": 1, "voice": "", "motion": "w-happy-wandahoi01", "facial": "face_surprise_01" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "绘名", "content": "确实好听。但总觉得……\n像在照着'会被喜欢的样子'写。", "ttsText": "確かにいい曲だけど、なんていうか……\n「好かれる形」をなぞって書いてるみたいに聞こえる。", "modelId": 2, "voice": "", "motion": "w-cool-tilthead01", "facial": "face_serious_01" } },
    { "type": "Motion", "wait": false, "delay": 0.1, "data": { "modelId": 3, "motion": "w-normal-trouble01", "facial": "face_surprise_01", "facialFirst": false } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "奏", "content": "被你看出来了啊……\n其实我自己，也一直在怕这一点。", "ttsText": "絵名にはわかっちゃったんだ……。\n実は私も、ずっとそこが怖かった。", "modelId": 3, "voice": "", "motion": "w-normal-trouble01", "facial": "face_trouble_01" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "瑞希", "content": "说起来，真冬最近好安静哦。\nNightcord 上都快看不见她的人了。", "ttsText": "そういえば、まふゆ最近静かだよね。\nNightcordでも姿ほとんど見ないし。", "modelId": 1, "voice": "", "motion": "w-happy-lookaway01", "facial": "face_trouble_01" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "绘名", "content": "她这个月只说了一句话——\n「奏的新曲，会是什么颜色呢」。", "ttsText": "今月、彼女が言ったのはたった一言——\n「奏の新曲、何色になるんだろう」って。", "modelId": 2, "voice": "", "motion": "w-normal-nod01", "facial": "face_serious_01" } },
    { "type": "Motion", "wait": false, "delay": 0.1, "data": { "modelId": 3, "motion": "w-normal-trouble01", "facial": "face_surprise_01", "facialFirst": false } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "奏", "content": "那是我第一次，听她主动说想听我的歌。\n所以这一首……我无论如何都想写完。", "ttsText": "彼女が自分から聴きたいって言ったの、初めてだった。\nだからこの曲は……どうしても完成させたい。", "modelId": 3, "voice": "", "motion": "w-kanade-glad01", "facial": "face_shy_01" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "绘名", "content": "行了，我去把她拽过来。\n真冬那家伙，嘴上说不来，身体很诚实的。", "ttsText": "よし、私が引っ張ってくる。\nまふゆのやつ、来ないと言いながら反応は早いから。", "modelId": 2, "voice": "", "motion": "w-cute-angry01", "facial": "face_smile_02" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "瑞希", "content": "那我先去煮可可！\n等黎明的仪式感，还是要有的嘛～", "ttsText": "じゃあ私、ココア作ってくる！\n夜明けまでの儀式は大事だからね〜。", "modelId": 1, "voice": "", "motion": "w-happy-nod01", "facial": "face_smile_01" } },
    { "type": "HideTalk", "wait": true, "delay": 0.2 },
    { "type": "LayoutClear", "wait": true, "delay": 0.1, "data": { "modelId": 2, "from": { "side": "Right", "offset": 0 }, "to": { "side": "Right", "offset": 100 }, "motion": "w-normal-nod01", "facial": "face_smile_02", "moveSpeed": "Normal" } },
    { "type": "LayoutClear", "wait": true, "delay": 0.1, "data": { "modelId": 1, "from": { "side": "Left", "offset": 0 }, "to": { "side": "Left", "offset": -100 }, "motion": "w-cute-nod01", "facial": "face_smile_01", "moveSpeed": "Normal" } },
    { "type": "Talk", "wait": false, "delay": 0.2, "data": { "speaker": "奏", "content": "真冬……\n我写的歌，真的能到你心里吗。", "ttsText": "まふゆ……\n私の歌は、本当にあなたに届くかな。", "modelId": 3, "voice": "", "motion": "w-kanade-lookdown01", "facial": "face_normal_01" } },

    { "type": "LayoutAppear", "wait": true, "delay": 0.2, "data": { "modelId": 4, "from": { "side": "Right", "offset": 100 }, "to": { "side": "Right", "offset": 0 }, "motion": "w-normal-lookaway01", "facial": "face_serious_01", "facialFirst": true, "moveSpeed": "Normal" } },
    { "type": "Talk", "wait": false, "delay": 0.2, "data": { "speaker": "真冬", "content": "……我在。不用拽。", "ttsText": "……いる。引っ張ってこなくていい。", "modelId": 4, "voice": "", "motion": "w-normal-lookaway01", "facial": "face_serious_01" } },
    { "type": "LayoutAppear", "wait": true, "delay": 0.2, "data": { "modelId": 1, "from": { "side": "Left", "offset": -100 }, "to": { "side": "Left", "offset": 0 }, "motion": "w-normal-greeting01", "facial": "face_smile_02", "facialFirst": true, "moveSpeed": "Normal" } },
    { "type": "Talk", "wait": false, "delay": 0.2, "data": { "speaker": "瑞希", "content": "哇，真冬来得比外卖还快！\n可可刚好……啊，三人份刚好多！", "ttsText": "わ、まふゆ配達より早い！\nココアちょうど……あ、三人分ちょうど多いか！", "modelId": 1, "voice": "", "motion": "w-happy-glad01", "facial": "face_smile_02" } },
    { "type": "Motion", "wait": false, "delay": 0.1, "data": { "modelId": 4, "motion": "w-happy-lookaway01", "facial": "face_normal_01", "facialFirst": false } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "真冬", "content": "曲子，放出来。", "ttsText": "曲、かけて。", "modelId": 4, "voice": "", "motion": "w-normal-nod01", "facial": "face_serious_01" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "奏", "content": "嗯……请听。\n最后一段，还是空的。", "ttsText": "うん……聴いて。\nラストの一段落は、まだ空のまま。", "modelId": 3, "voice": "", "motion": "w-normal-nod01", "facial": "face_sad_01" } },
    { "type": "Motion", "wait": false, "delay": 0.1, "data": { "modelId": 4, "motion": "w-normal-yurayura01", "facial": "face_closeeye_01", "facialFirst": false } },
    { "type": "Talk", "wait": false, "delay": 0.2, "data": { "speaker": "真冬", "content": "……写到这里就停下吧。\n这首曲子，在讨好。", "ttsText": "……ここでやめなよ。\nこの曲、誰かを喜ばせようとしてる。", "modelId": 4, "voice": "", "motion": "w-normal-angry01", "facial": "face_serious_01" } },
    { "type": "Motion", "wait": false, "delay": 0.1, "data": { "modelId": 3, "motion": "w-normal-trouble01", "facial": "face_surprise_01", "facialFirst": false } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "奏", "content": "诶……", "ttsText": "え……", "modelId": 3, "voice": "", "motion": "w-normal-trouble01", "facial": "face_surprise_01" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "真冬", "content": "和以前一样。\n你在写'会被喜欢的歌'，不是你想说的歌。", "ttsText": "いつも通り。\nあなたは「好かれる歌」を書いてる。自分が言いたい歌じゃなく。", "modelId": 4, "voice": "", "motion": "w-cool-angry01", "facial": "face_angry_01" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "瑞希", "content": "真、真冬，话别说太重呀！\n奏她为了这首曲子熬了好多个通宵……", "ttsText": "ま、まふゆ、言いすぎだよ！\n奏、この曲のために何晩も徹夜して……", "modelId": 1, "voice": "", "motion": "w-cute-fidget01", "facial": "face_trouble_01" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "真冬", "content": "我知道。所以才要说。\n我讨厌这样的歌——因为你眼睛里，没有它。", "ttsText": "わかってる。だから言うの。\nこんな曲、嫌い——あなたの目に、それが映ってないから。", "modelId": 4, "voice": "", "motion": "w-normal-lookaway01", "facial": "face_sad_01" } },
    { "type": "Motion", "wait": false, "delay": 0.1, "data": { "modelId": 3, "motion": "w-kanade-lookdown01", "facial": "face_sad_01", "facialFirst": false } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "奏", "content": "可是……是你说过想听我的歌。\n所以我一直想着，怎么写你才会喜欢……", "ttsText": "でも……あなたが私の歌を聴きたいって言ったから。\nだからずっと、どう書けば喜んでもらえるかって……", "modelId": 3, "voice": "", "motion": "w-kanade-lookdown01", "facial": "face_cry_01" } },
    { "type": "Talk", "wait": false, "delay": 0.2, "data": { "speaker": "真冬", "content": "——是你，先对我说的。", "ttsText": "——先に言ったのは、あなたよ。", "modelId": 4, "voice": "", "motion": "w-normal-nod01", "facial": "face_sad_01" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "真冬", "content": "「写一首就算没有人听、也要写的歌」。\n把我从空壳里拉出来的，是那句话。", "ttsText": "「誰にも聴かれなくても、書かなきゃいけない歌を書きな」。\n空っぽの私を引き上げたのは、あの言葉。", "modelId": 4, "voice": "", "motion": "w-normal-lookaway01", "facial": "face_sad_02" } },
    { "type": "Talk", "wait": false, "delay": 0.2, "data": { "speaker": "真冬", "content": "现在……轮到你了，宵崎奏。", "ttsText": "今度は……あなたの番よ、宵崎奏。", "modelId": 4, "voice": "", "motion": "w-cool-tilthead01", "facial": "face_serious_01" } },
    { "type": "Motion", "wait": false, "delay": 0.1, "data": { "modelId": 1, "motion": "w-normal-shy01", "facial": "face_smile_01", "facialFirst": false } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "奏", "content": "真冬……", "ttsText": "まふゆ……", "modelId": 3, "voice": "", "motion": "w-normal-relief01", "facial": "face_cry_01" } },
    { "type": "Talk", "wait": false, "delay": 0.2, "data": { "speaker": "真冬", "content": "我去外面走走。\n黎明之前，会回来。", "ttsText": "ちょっと外に出てくる。\n夜明け前には戻るから。", "modelId": 4, "voice": "", "motion": "w-normal-nod01", "facial": "face_smile_01" } },
    { "type": "HideTalk", "wait": true, "delay": 0.2 },
    { "type": "LayoutClear", "wait": true, "delay": 0.1, "data": { "modelId": 4, "from": { "side": "Right", "offset": 0 }, "to": { "side": "Right", "offset": 100 }, "motion": "w-normal-nod01", "facial": "face_smile_01", "moveSpeed": "Normal" } },
    { "type": "Talk", "wait": false, "delay": 0.2, "data": { "speaker": "奏", "content": "'轮到你了'……吗。\n真冬，你总是在最疼的地方，推我一把。", "ttsText": "「あなたの番」……か。\nまふゆはいつも、一番痛いところで私を押してくる。", "modelId": 3, "voice": "", "motion": "w-kanade-nod01", "facial": "face_normal_01" } },

    { "type": "ChangeBackgroundImage", "wait": true, "delay": 0, "data": { "imageId": 3 } },
    { "type": "LayoutAppear", "wait": true, "delay": 0.2, "data": { "modelId": 2, "from": { "side": "Right", "offset": 100 }, "to": { "side": "Right", "offset": 0 }, "motion": "w-cool-tilthead01", "facial": "face_trouble_01", "facialFirst": true, "moveSpeed": "Normal" } },
    { "type": "Talk", "wait": false, "delay": 0.2, "data": { "speaker": "绘名", "content": "……全、都听到了。\n先说好，我不是偷听，是门没关。", "ttsText": "……ぜ、全部聞こえてたわよ。\n先に言っとくけど、盗み聞きじゃない、ドアが開いてただけ。", "modelId": 2, "voice": "", "motion": "w-cool-tilthead01", "facial": "face_trouble_01" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "瑞希", "content": "绘名说教的时候，\n真的超像妈妈哦。", "ttsText": "絵名のお説教、\nママみたいでびっくりした〜。", "modelId": 1, "voice": "", "motion": "w-cute-tilthead01", "facial": "face_smile_02" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "绘名", "content": "吵死了！……不过奏，我也有话。\n我一直嫉妒你的才华，嫉妒到发抖。", "ttsText": "うるさい！……でも奏、私にも言わせて。\nあなたの才能、嫉妬で震えるほど羨ましかった。", "modelId": 2, "voice": "", "motion": "w-cute-angry01", "facial": "face_angry_01" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "绘名", "content": "可比起这个……\n我更怕哪天打开 Nightcord，你不在了。", "ttsText": "でもそれより……\nある日 Nightcord を開いて、あなたがいなかったらって方が怖い。", "modelId": 2, "voice": "", "motion": "w-cool-sad01", "facial": "face_sad_01" } },
    { "type": "Motion", "wait": false, "delay": 0.1, "data": { "modelId": 3, "motion": "w-normal-relief01", "facial": "face_surprise_01", "facialFirst": false } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "奏", "content": "绘名……", "ttsText": "絵名……", "modelId": 3, "voice": "", "motion": "w-normal-relief01", "facial": "face_smile_01" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "瑞希", "content": "那我也坦白～我总是用'可爱'\n把心事包起来。怕认真的自己，不被喜欢。", "ttsText": "じゃあ私も白状〜私はいつも「可愛い」で\n本音を包んでた。真剣な自分が嫌われないか怖くて。", "modelId": 1, "voice": "", "motion": "w-normal-shy01", "facial": "face_shy_01" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "瑞希", "content": "所以我们四个，谁都不许再一个人硬扛。\n说好了哦？", "ttsText": "だから私たち四人は、もう一人で抱え込まない。\n約束ね？", "modelId": 1, "voice": "", "motion": "w-happy-nod01", "facial": "face_smile_01" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "奏", "content": "嗯……原来我的夜里，\n一直都有你们。", "ttsText": "うん……私の夜には、\nずっとみんながいたんだね。", "modelId": 3, "voice": "", "motion": "w-kanade-glad01", "facial": "face_cry_01" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "绘名", "content": "那最后一段怎么办？\n《夜明けの色》……把大家的颜色都画进去不就好了。", "ttsText": "で、ラストはどうするの？\n『夜明けの色』……みんなの色を全部入れたらいいじゃない。", "modelId": 2, "voice": "", "motion": "w-normal-nod01", "facial": "face_smile_02" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "瑞希", "content": "好耶！那我出粉色！\n最可爱的那种粉！", "ttsText": "やった！じゃあ私はピンク！\n一番可愛いピンクね！", "modelId": 1, "voice": "", "motion": "w-happy-wandahoi01", "facial": "face_sparkling_01" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "绘名", "content": "那我出蓝色。冷静一点的——绘名蓝。", "ttsText": "じゃあ私は青。クールな、絵名ブルーね。", "modelId": 2, "voice": "", "motion": "w-cool-glad01", "facial": "face_smile_03" } },
    { "type": "Motion", "wait": false, "delay": 0.1, "data": { "modelId": 3, "motion": "w-kanade-nod01", "facial": "face_smile_01", "facialFirst": false } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "奏", "content": "那我，把大家的声音都写进去。\n粉色、蓝色……还有，雪一样的白色。", "ttsText": "じゃあ私は、みんなの声を全部書き込む。\nピンクも、青も……それから、雪みたいな白も。", "modelId": 3, "voice": "", "motion": "w-kanade-nod01", "facial": "face_smile_02" } },
    { "type": "Talk", "wait": false, "delay": 0.2, "data": { "speaker": "奏", "content": "——在吗，真冬。\n最后一句，想留给你。", "ttsText": "——ねえ、まふゆ。\n最後の一句は、あなたに残しておきたい。", "modelId": 3, "voice": "", "motion": "w-normal-trouble01", "facial": "face_shy_01" } },
    { "type": "HideTalk", "wait": true, "delay": 0.2 },
    { "type": "LayoutClear", "wait": true, "delay": 0.1, "data": { "modelId": 1, "from": { "side": "Left", "offset": 0 }, "to": { "side": "Left", "offset": -100 }, "motion": "w-cute-nod01", "facial": "face_smile_01", "moveSpeed": "Normal" } },
    { "type": "LayoutAppear", "wait": true, "delay": 0.2, "data": { "modelId": 4, "from": { "side": "Left", "offset": -100 }, "to": { "side": "Left", "offset": 0 }, "motion": "w-normal-nod01", "facial": "face_smile_01", "facialFirst": true, "moveSpeed": "Normal" } },
    { "type": "Talk", "wait": false, "delay": 0.2, "data": { "speaker": "真冬", "content": "……我在。词，已经想好了。", "ttsText": "……いる。言葉は、もう決めてある。", "modelId": 4, "voice": "", "motion": "w-normal-nod01", "facial": "face_smile_01" } },
    { "type": "Talk", "wait": false, "delay": 0.2, "data": { "speaker": "真冬", "content": "「夜不是被谁熬过去的」——\n「是我们，一起住在夜里」。", "ttsText": "「夜は誰かが乗り越えたものじゃなくて」——\n「私たちが、一緒に住んでいた場所」——", "modelId": 4, "voice": "", "motion": "w-normal-lookaway01", "facial": "face_shy_01" } },
    { "type": "Motion", "wait": false, "delay": 0.1, "data": { "modelId": 3, "motion": "w-kanade-glad01", "facial": "face_surprise_01", "facialFirst": false } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "奏", "content": "夜，不是被谁熬过去的……\n是我们，一起住在夜里。", "ttsText": "夜は誰かが乗り越えたものじゃなくて……\n私たちが、一緒に住んでいた場所なんだ。", "modelId": 3, "voice": "", "motion": "w-kanade-glad01", "facial": "face_cry_01" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "真冬", "content": "后面两句，你自己写。\n你的歌——现在有颜色了。", "ttsText": "残りの二句は、自分で書きなさい。\nあなたの歌——今、色がついたわ。", "modelId": 4, "voice": "", "motion": "w-normal-nod01", "facial": "face_smile_01" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "绘名", "content": "喂喂，别只有你们俩感人。\n快写完，天都要亮了！", "ttsText": "こら、二人だけ感動してないで。\n早く書き終えて、空が明るくなってるわよ！", "modelId": 2, "voice": "", "motion": "w-cute-angry01", "facial": "face_smile_02" } },

    { "type": "HideTalk", "wait": true, "delay": 0.2 },
    { "type": "BlackOut", "wait": true, "delay": 0, "data": { "duration": 800 } },
    { "type": "ChangeBackgroundImage", "wait": true, "delay": 0, "data": { "imageId": 2 } },
    { "type": "BlackIn", "wait": true, "delay": 0, "data": { "duration": 1000 } },
    { "type": "Telop", "wait": true, "delay": 0.2, "data": { "content": "05:24 —— 夜明け" } },

    { "type": "Talk", "wait": false, "delay": 0.2, "data": { "speaker": "真冬", "content": "……天，亮了。", "ttsText": "……空が、明るくなってきた。", "modelId": 4, "voice": "", "motion": "w-normal-lookaway01", "facial": "face_normal_01" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "绘名", "content": "哇，真的诶。天空在变色。\n粉一点，蓝一点……全混在一起了。", "ttsText": "わあ、ほんとだ。空の色が変わっていく。\nピンクになって、青になって……全部混ざってる。", "modelId": 2, "voice": "", "motion": "w-cute-glad01", "facial": "face_sparkling_01" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "奏", "content": "那么——请听。\n《夜明けの色》，完整版。", "ttsText": "じゃあ——聴いて。\n『夜明けの色』、フルバージョン。", "modelId": 3, "voice": "", "motion": "w-kanade-glad01", "facial": "face_smile_01" } },
    { "type": "Motion", "wait": false, "delay": 0.1, "data": { "modelId": 4, "motion": "w-normal-nod01", "facial": "face_closeeye_01", "facialFirst": false } },
    { "type": "Talk", "wait": false, "delay": 0.2, "data": { "speaker": "奏", "content": "黎明不是夜的结束，\n是我们一起抬头的地方。", "ttsText": "夜明けは夜の終わりじゃなくて、\nみんなで一緒に顔を上げる場所。", "modelId": 3, "voice": "", "motion": "w-normal-yurayura01", "facial": "face_closeeye_01" } },
    { "type": "Talk", "wait": false, "delay": 0.2, "data": { "speaker": "真冬", "content": "你的歌里，有颜色。", "ttsText": "あなたの歌に、色があった。", "modelId": 4, "voice": "", "motion": "w-normal-nod01", "facial": "face_cry_01" } },
    { "type": "Talk", "wait": false, "delay": 0.2, "data": { "speaker": "奏", "content": "那是因为——夜里的每个人，\n都在发光。", "ttsText": "それはね——夜の一人ひとりが、\nみんな光ってたから。", "modelId": 3, "voice": "", "motion": "w-normal-relief01", "facial": "face_smile_01" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "绘名", "content": "好——曲子这就发出去！\n发完我要去睡回笼觉！", "ttsText": "よーし、曲をアップするわよ！\nアップしたら二度寝するからね！", "modelId": 2, "voice": "", "motion": "w-normal-relief01", "facial": "face_smile_02" } },
    { "type": "HideTalk", "wait": true, "delay": 0.2 },
    { "type": "LayoutClear", "wait": true, "delay": 0.1, "data": { "modelId": 2, "from": { "side": "Right", "offset": 0 }, "to": { "side": "Right", "offset": 100 }, "motion": "w-normal-relief01", "facial": "face_smile_02", "moveSpeed": "Normal" } },
    { "type": "LayoutAppear", "wait": true, "delay": 0.2, "data": { "modelId": 1, "from": { "side": "Right", "offset": 100 }, "to": { "side": "Right", "offset": 0 }, "motion": "w-normal-greeting01", "facial": "face_smile_01", "facialFirst": true, "moveSpeed": "Normal" } },
    { "type": "Talk", "wait": false, "delay": 0.2, "data": { "speaker": "瑞希", "content": "当当——！早餐买回来了！\n庆祝《夜明けの色》完成～！", "ttsText": "じゃじゃーん！朝ごはん買ってきた〜！\n『夜明けの色』完成おめでとうの！！", "modelId": 1, "voice": "", "motion": "w-happy-glad01", "facial": "face_smile_01" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "瑞希", "content": "真冬也要吃哦！\n哭了的话，热量是零！", "ttsText": "まふゆも食べなよ！\n泣いた分のカロリーはゼロだから！", "modelId": 1, "voice": "", "motion": "w-cute-tilthead01", "facial": "face_smile_02" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "真冬", "content": "……我没有哭。\n……谢谢。", "ttsText": "……泣いてないわ。\n……ありがとう。", "modelId": 4, "voice": "", "motion": "w-normal-lookaway01", "facial": "face_shy_01" } },
    { "type": "Talk", "wait": false, "delay": 0.15, "data": { "speaker": "奏", "content": "大家，谢谢你。\n黎明之后，也请多指教。", "ttsText": "みんな、ありがとう。\n夜明けの後も、よろしくね。", "modelId": 3, "voice": "", "motion": "w-normal-nod01", "facial": "face_smile_01" } },
    { "type": "Motion", "wait": false, "delay": 0.1, "data": { "modelId": 1, "motion": "w-happy-nod01", "facial": "face_smile_01", "facialFirst": false } },

    { "type": "HideTalk", "wait": true, "delay": 0.2 },
    { "type": "LayoutClear", "wait": true, "delay": 0.1, "data": { "modelId": 1, "from": { "side": "Right", "offset": 0 }, "to": { "side": "Right", "offset": 100 }, "motion": "w-happy-wandahoi01", "facial": "face_smile_01", "moveSpeed": "Normal" } },
    { "type": "LayoutClear", "wait": true, "delay": 0.1, "data": { "modelId": 4, "from": { "side": "Left", "offset": 0 }, "to": { "side": "Left", "offset": -100 }, "motion": "w-normal-nod01", "facial": "face_smile_01", "moveSpeed": "Normal" } },

    { "type": "Talk", "wait": false, "delay": 0.3, "data": { "speaker": "奏", "content": "黎明的颜色，从来不是被画出来的。", "ttsText": "夜明けの色は、描かれたものじゃなくて。", "modelId": 3, "voice": "", "motion": "w-kanade-nod01", "facial": "face_normal_01" } },
    { "type": "Talk", "wait": false, "delay": 0.2, "data": { "speaker": "奏", "content": "是我们一起，从夜里走过来的颜色。\n——那么，晚安。早安。", "ttsText": "私たちが一緒に、夜の中から歩いてきた色。\n——それじゃ、おやすみ。おはよう。", "modelId": 3, "voice": "", "motion": "w-normal-relief01", "facial": "face_smile_01" } },
    { "type": "HideTalk", "wait": true, "delay": 0.2 },
    { "type": "LayoutClear", "wait": true, "delay": 0.1, "data": { "modelId": 3, "from": { "side": "Center", "offset": 0 }, "to": { "side": "Center", "offset": 100 }, "motion": "w-normal-nod01", "facial": "face_smile_01", "moveSpeed": "Normal" } },
    { "type": "BlackOut", "wait": true, "delay": 0, "data": { "duration": 700 } },
    { "type": "Telop", "wait": true, "delay": 0.2, "data": { "content": "『夜明けの色』—— 完" } }
  ]
